import ejemplos.Funciones.y
import ejemplos.Persona.z

VARIABILES>
esto fuerza : numerus 10;
esto comandante : textum "Estudiante X";

MAIOR>
>> "Hola comandante!";
>> "Tu fuerza es: " >> calcularPoder(fuerza);

esto p : novus Persona("Carlos", 25);
>> "Nombre: " >> p.getNombre();
>> "Edad: " >> p.getEdad();
p.saludar();

>> "Suma: " >> sumar(fuerza, 5);

FINIS;